# Rust CLI runtime: DeepSeek is the default provider; Anthropic is its fallback.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DASHSCOPE_API_KEY=

# AXiM integration used by the local Onyx CLI.
AXIM_CORE_URL=https://api.axim.us.com
VITE_ONYX_WORKER_URL=https://onyx-edge.axim.us.com
AXIM_ONYX_SECRET=
AXIM_SERVICE_KEY=
AXIM_PRIMARY_EMAIL=
CHAT_ROUTING_MODE=proxy

# AXiM Passport SSO URL
PASSPORT_SSO_URL=https://passport.axim.us.com

# Cloudflare deployment credentials. Keep these in the shell or GitHub Actions
# secrets; they are not Worker runtime secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Supabase bindings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
