{
  "name": "onyx-mk3",
  "version": "1.0.0",
  "description": "Cloudflare Worker Edge Bridge for Onyx mk3 and AXiM Core",
  "main": "src/index.ts",
  "scripts": {
    "typegen": "wrangler types ./src/worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "build": "npm run typegen && npm run typecheck",
    "dev": "wrangler dev --config wrangler.jsonc",
    "format": "prettier --write src/**/*.ts",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.20.3",
    "miniflare": "^4.20260611.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
