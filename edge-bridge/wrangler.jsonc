{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onyx-edge-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "analytics_engine_datasets": [
    {
      "binding": "ONYX_EDGE_METRICS",
      "dataset": "onyx_edge_metrics"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../rust/crates/onyx/static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/healthz", "/ready", "/readyz", "/events"]
  },
  "routes": [
    {
      "pattern": "onyx-edge.axim.us.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Telemetry is delivered to the `telemetry-ingress` Supabase Edge Function.
    // This previously named `https://api.axim.us.com/telemetry`, a host that
    // returns 302 -> /404.html on every path, so the DLQ drain re-queued forever.
    // See DEFAULT_CORE_INGEST_URL in src/index.ts for the full reasoning.
    "CORE_INGEST_URL": "https://pvbcdndqjguzqeafhwhw.supabase.co/functions/v1/telemetry-ingress",
    "CORE_HITL_URL": "https://pvbcdndqjguzqeafhwhw.supabase.co/functions/v1/resolve-hitl",
    // Comma-separated. `getCorsHeaders` splits this list; it used to compare with
    // strict equality against a single value, so a list could never match.
    "ALLOWED_ORIGIN": "tauri://localhost,https://axim.us.com,https://passport.axim.us.com,https://onyx-edge.axim.us.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "PASSPORT_JWT_ISSUER": "https://pvbcdndqjguzqeafhwhw.supabase.co/auth/v1",
    "PASSPORT_JWKS_URL": "https://pvbcdndqjguzqeafhwhw.supabase.co/auth/v1/.well-known/jwks.json",
    "PASSPORT_JWT_AUDIENCE": "authenticated"
  },
  "d1_databases": [
    {
      "binding": "ONYX_DB",
      "database_name": "onyx-edge-bridge-db",
      "database_id": "5477ab45-92a4-4c0e-97c4-5fb2bae2f650",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONYX_STATE",
      "id": "049c627a0e144fddaee6ec4034c1f2bd"
    },
    {
      "binding": "ONYX_SESSION_STATE",
      "id": "1cb8dcf7fea24988b75aa43b73777364"
    },
    {
      "binding": "ONYX_PROMPT_CACHE",
      "id": "186183af00e3487ba5b70d7f0b0e8cbe"
    },
    {
      "binding": "ONYX_DISPATCH_LOCKS",
      "id": "4b72094b034d4732adbbfeaad4d33b2c"
    },
    {
      "binding": "ONYX_KV",
      "id": "84ebf13dd7d04a308474784c50603a5f"
    },
    {
      "binding": "ECOSYSTEM_METRICS_KV",
      "id": "82793751d3924b32bdf654716258f552"
    },
    {
      "binding": "EDGE_DLQ_KV",
      "id": "893b9bc503874204a6f40450b1177af7"
    },
    {
      "binding": "HITL_APPROVAL_KV",
      "id": "c2946428a321491a9ffc2a152a017017"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/5 * * * *"
    ]
  }
}
