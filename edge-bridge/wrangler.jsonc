{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onyx-edge-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "analytics_engine_datasets": [
    {
      "binding": "ONYX_EDGE_METRICS",
      "dataset": "onyx_edge_metrics"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../rust/crates/onyx/static",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "onyx-edge.axim.us.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CORE_INGEST_URL": "https://api.axim.us.com/v1/functions/telemetry-ingest",
    "ALLOWED_ORIGIN": "tauri://localhost"
  },
  "d1_databases": [
    {
      "binding": "ONYX_DB",
      "database_name": "onyx-db",
      "database_id": "8bbbbbbb-8888-8888-8888-888888888888"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONYX_STATE",
      "id": "049c627a0e144fddaee6ec4034c1f2bd"
    },
    {
      "binding": "ONYX_SESSION_STATE",
      "id": "1cb8dcf7fea24988b75aa43b73777364"
    },
    {
      "binding": "ONYX_PROMPT_CACHE",
      "id": "186183af00e3487ba5b70d7f0b0e8cbe"
    },
    {
      "binding": "ONYX_DISPATCH_LOCKS",
      "id": "4b72094b034d4732adbbfeaad4d33b2c"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/5 * * * *"
    ]
  }
}